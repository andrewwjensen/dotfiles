{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

# Install Homebrew if missing so this script is self-contained.
if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Install Homebrew packages
brew bundle --file=/dev/stdin <<EOF
# Packages for both personal and work
brew "age"
brew "ascii"
brew "awscli"
brew "bazel"
brew "boost"
brew "bpytop"
brew "btop"
brew "buildifier"
brew "chezmoi"
brew "cloudflared"
brew "coreutils"
brew "cppunit"
brew "csview"
brew "csvlens"
brew "diffutils"
brew "fd"
brew "figlet"
brew "findutils"
brew "gawk"
brew "gdbm"
brew "git"
brew "git-lfs"
brew "gmp"
brew "gnu-sed"
brew "gnu-tar"
brew "gnupg"
brew "go"
brew "gpgme"
brew "graphviz"
brew "grep"
brew "highlight"
brew "htop"
brew "ispell"
brew "jq"
brew "lesspipe"
brew "libxml2"
brew "libyaml"
brew "logrotate"
brew "lynx"
brew "moreutils", link: false
brew "mprocs"
brew "nano"
brew "ncurses"
brew "openconnect"
brew "openssl@3"
brew "p7zip"
brew "parallel"
brew "pcal"
brew "pixi"
brew "pkgconf"
brew "popt"
brew "powerlevel10k"
brew "pyenv"
brew "python@3.14"
brew "r"
brew "readline"
brew "ripgrep"
brew "shfmt"
brew "skopeo"
brew "source-highlight"
brew "sponge"
brew "sqlite"
brew "telnet"
brew "thefuck"
brew "tmux"
brew "tree"
brew "uv"
brew "vim"
brew "watch"
brew "wdiff"
brew "wget"
brew "xq"
brew "xz"
brew "yq"
brew "zlib"
brew "zsh"
brew "zsh-completions"
brew "zsh-syntax-highlighting"

# For work
{{ if .is_work }}
brew "git-remote-codecommit"
{{ end }}

cask "kopiaui"
EOF

{{- end -}}
