brew "uv"
brew "vim"
brew "watch"
brew "wdiff"
brew "wget"
brew "xq"
brew "xz"
brew "yq"
brew "zlib"
brew "zsh"
brew "zsh-completions"
brew "zsh-syntax-highlighting"

#{{ if .is_work }}
# For work only
brew "git-remote-codecommit"

#{{ else }}
# For personal only
cask "kopiaui"

#{{ end }}

EOF

# Bootstrap Oh My Zsh when missing, but don't launch a shell or replace ~/.zshrc.
if [ ! -d "${HOME}/.oh-my-zsh" ]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

#{{- end -}}
