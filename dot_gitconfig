[diff]
	tool = bc
	guitool = bc
	algorithm = patience
[difftool]
	prompt = false
[user]
	name = Andrew Jensen
	email = andy.jensen@trane.com
[push]
	default = tracking
[credential]
	helper = cache
#	helper = gnome-keyring
[merge]
	tool = bc
    conflictStyle = zdiff3
[mergetool]
	prompt = false
[alias]
	bc = difftool --tool=bc --dir-diff
	mt = mergetool
	st = status -s
	exec = "!exec "
[color]
	ui = auto
[core]
	autocrlf = input
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true     # use n and N to move between files
    side-by-side = true # enable side-by-side view
    line-numbers = true
    grep-file-style = bold purple
[pretty]
	andy = "%C(auto)%h%d %an %C(cyan)%ad%C(reset) (%C(magenta)%ar%C(reset)) %s"
[log]
	date = local
[pull]
	rebase = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[difftool "bc"]
	trustExitCode = true
[mergetool "bc"]
	trustExitCode = true
[init]
	defaultBranch = main
